# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon

# Opcional: endereço do Conversor MD no serverchacha (dá para definir também na própria aba, por aparelho)
NEXT_PUBLIC_CONVERSOR_URL=
